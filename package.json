{
  "name": "universal-agent-architect",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline-first agent architecture planner — early prototype",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-ast-assets.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm run test && node scripts/check-skills.mjs && node scripts/check-capability-registry.mjs",
    "plan": "node scripts/cli.mjs",
    "mcp": "node scripts/mcp-server.mjs",
    "serve": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "tree-sitter-python": "0.25.0",
    "tree-sitter-typescript": "0.23.2",
    "typescript": "5.8.3",
    "web-tree-sitter": "0.27.1"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0"
  }
}

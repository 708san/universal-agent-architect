    "input": {
      "paths": [
        "package.json", "src/api.ts", "src/ui.tsx", "src/db.ts", "src/auth.ts",
        "tests/api.test.ts", "tests/ui.test.tsx", "tests/db.test.ts", "docs/design.md",
        ".github/workflows/ci.yml", "AGENTS.md"
      ],
      "manifests": { "package.json": "{\"dependencies\":{\"react\":\"19.0.0\",\"express\":\"5.0.0\"},\"devDependencies\":{\"jest\":\"30.0.0\"}}" }
    },
    "request": { "target": "codex", "workType": "coding", "needsReview": true, "independentWorkstreams": 3, "securityProfile": "strict" },

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/708san/universal-agent-architect/schema/runtime-verification-evidence-0.1.json",
  "title": "Universal Agent Architect Runtime Verification Evidence 0.1",
  "description": "Metadata-only evidence record. It does not grant permissions or prove runtime isolation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "target", "edition", "version", "verifiedAt", "overallStatus", "reviewStatus", "capabilities", "evidenceIds", "limitations"],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "target": { "enum": ["codex", "claude-code", "gemini-cli", "antigravity", "chatgpt"] },
    "edition": { "type": "string", "minLength": 1, "maxLength": 100 },
    "version": { "type": "string", "minLength": 1, "maxLength": 100 },
    "verifiedAt": { "type": "string", "format": "date" },
    "overallStatus": { "enum": ["not-tested", "partial", "verified", "failed"] },
    "reviewStatus": { "enum": ["unreviewed", "human-reviewed"] },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instructions", "skills", "subagents", "mcp", "permissions"],
      "properties": {
        "instructions": { "$ref": "#/$defs/capabilityStatus" },
        "skills": { "$ref": "#/$defs/capabilityStatus" },
        "subagents": { "$ref": "#/$defs/capabilityStatus" },
        "mcp": { "$ref": "#/$defs/capabilityStatus" },
        "permissions": { "$ref": "#/$defs/capabilityStatus" }
      }
    },
    "evidenceIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "limitations": {
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[^\\u0000-\\u001f\\u007f]*$" }
    }
  },
  "$defs": {
    "capabilityStatus": {
      "enum": ["not-tested", "format-verified", "runtime-verified", "failed"]
    }
  }
}

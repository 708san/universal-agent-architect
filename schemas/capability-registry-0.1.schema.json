{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/708san/universal-agent-architect/schema/capability-registry-0.1.json",
  "title": "Universal Agent Architect Capability Registry 0.1",
  "description": "Reviewed target capability snapshot. Registry data is descriptive and does not grant runtime permissions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "checkedAt", "entries"],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "checkedAt": { "type": "string", "format": "date" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "status": {
      "enum": ["verified", "partial", "planned", "unknown", "unsupported", "experimental"]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "edition", "version", "checkedAt", "status", "sourceUrls", "capabilities", "fixtureIds"],
      "properties": {
        "target": { "enum": ["codex", "claude-code", "gemini-cli", "antigravity", "chatgpt"] },
        "edition": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "checkedAt": { "type": "string", "format": "date" },
        "status": { "$ref": "#/$defs/status" },
        "sourceUrls": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "format": "uri", "pattern": "^https://" }
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["instructions", "skills", "subagents", "mcp"],
          "properties": {
            "instructions": { "$ref": "#/$defs/status" },
            "skills": { "$ref": "#/$defs/status" },
            "subagents": { "$ref": "#/$defs/status" },
            "mcp": { "$ref": "#/$defs/status" }
          }
        },
        "fixtureIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "notes": { "type": "string" }
      }
    }
  }
}
